<?xml version="1.0" encoding="utf-8"?>
<!-- The trial's package identity. Registered from the build folder in Developer Mode
     (Add-AppxPackage -Register), so nothing needs signing while trying it out. What the Windows AI
     APIs need, per Microsoft's docs: the systemAIModels capability, and a MaxVersionTested of
     10.0.26226.0 or later, or loading the model fails with "Not declared by app". -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
  IgnorableNamespaces="uap uap5 desktop4 rescap systemai">

  <Identity Name="TheWorkBench.DescribeTrial" Publisher="CN=TheWorkBench Trial" Version="1.0.0.0" ProcessorArchitecture="arm64" />

  <Properties>
    <DisplayName>Describe Trial</DisplayName>
    <PublisherDisplayName>TheWorkBench</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26226.0" />
    <PackageDependency Name="Microsoft.WindowsAppRuntime.1.8" MinVersion="8000.994.2142.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="DescribeTrial" Executable="DescribeTrial.exe" EntryPoint="Windows.FullTrustApplication"
                 desktop4:Subsystem="console" desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements DisplayName="Describe Trial" Description="Describes a picture with Windows' on-device model"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" AppListEntry="none" />
      <Extensions>
        <!-- Run from any terminal as describe-trial, with the package's identity. -->
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="describe-trial.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <systemai:Capability Name="systemAIModels" />
  </Capabilities>
</Package>
