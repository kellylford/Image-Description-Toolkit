<Project Sdk="Microsoft.NET.Sdk">
  <!-- A trial: can a packaged app on a Copilot+ PC describe a picture with Windows' on-device
       model (Microsoft.Windows.AI.Imaging.ImageDescriptionGenerator)? See TheWorkBench#165. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <!-- Packaged: identity comes from the hand-written AppxManifest.xml registered beside the exe,
         so the Windows App SDK's bootstrapper (for unpackaged apps) isn't used. -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- The SDK's start-up hook for unpackaged apps runs before Main and crashes without package
         identity; packaged, it isn't needed. Off, so Main can see the problem and fix it. -->
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>
  <ItemGroup>
    <None Include="AppxManifest.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>
</Project>
