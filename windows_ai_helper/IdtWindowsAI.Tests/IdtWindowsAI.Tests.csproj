<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests the helper's protocol, which is plain C#: runs anywhere, including CI with no NPU.
       Protocol.cs is compiled in directly rather than referencing the packaged exe. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\IdtWindowsAI\Protocol.cs" Link="Protocol.cs" />
    <Compile Include="..\IdtWindowsAI\Server.cs" Link="Server.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
