<Project Sdk="Microsoft.NET.Sdk">
  <!-- IDT's Windows AI helper. Built per architecture by ..\build_helper.ps1, which also lays out
       the package (AppxManifest.xml with the architecture and publisher filled in). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>IdtWindowsAI</AssemblyName>
    <RootNamespace>IdtWindowsAI</RootNamespace>
    <Version>1.0.0</Version>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <!-- Packaged: identity comes from the package's manifest, so the Windows App SDK's start-up
         hook for unpackaged apps isn't wanted. Left on, it crashes before Main whenever the exe is
         started without identity, which Program.cs instead handles by restarting itself. -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>
  <ItemGroup>
    <!-- Its runtime, Microsoft.WindowsAppRuntime.1.8 8000.994.2142.0, is what AppxManifest.xml
         depends on; keep the two in step. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>
</Project>
