<Project Sdk="Microsoft.NET.Sdk">
  <!-- IDT's Windows AI helper. Built per architecture by ..\build_helper.ps1, which also lays out
       the package (AppxManifest.xml with the architecture and publisher filled in). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>IdtWindowsAI</AssemblyName>
    <RootNamespace>IdtWindowsAI</RootNamespace>
    <Version>1.0.0</Version>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <!-- Trim the parts of .NET this doesn't use: about 48 MB a package rather than 116, which
         matters because IDT's installer carries one per architecture. "partial" trims only what
         is marked safe to trim (the .NET libraries); the Windows Runtime projections and this
         app's own code are kept whole (see TrimmerRootAssembly below). "partial" also hides the
         trim-analysis warnings, so a build that trimming has broken still builds cleanly: a
         change here must be re-tested on a Copilot+ PC. Kept whole, two of the projections still
         report IL2104 ("produced trim warnings") about themselves, which TreatWarningsAsErrors
         would make a failed build; it says nothing about this app, so it is silenced. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <!-- Packaged: identity comes from the package's manifest, so the Windows App SDK's start-up
         hook for unpackaged apps isn't wanted. Left on, it crashes before Main whenever the exe is
         started without identity, which Program.cs instead handles by restarting itself. -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kept whole by the trimmer. These reach the model through Windows Runtime activation,
         which the trimmer can't see: trimmed, every description fails with InternalError
         (found on a Copilot+ PC, 10/6/2026). -->
    <TrimmerRootAssembly Include="Microsoft.Windows.SDK.NET" />
    <TrimmerRootAssembly Include="WinRT.Runtime" />
    <TrimmerRootAssembly Include="Microsoft.Windows.AI.Projection" />
    <TrimmerRootAssembly Include="Microsoft.Windows.AI.Imaging.Projection" />
    <TrimmerRootAssembly Include="Microsoft.Windows.AI.ContentSafety.Projection" />
    <TrimmerRootAssembly Include="Microsoft.Windows.AI.Foundation.Projection" />
    <TrimmerRootAssembly Include="Microsoft.Graphics.Imaging.Projection" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only the parts of the Windows App SDK the helper uses: the AI APIs, the Foundation and Base
         they need, and the Runtime the build requires alongside them. The whole SDK would also bring WinUI, WebView2 and the rest, more than
         doubling the package for nothing. The runtime these come from,
         Microsoft.WindowsAppRuntime.1.8 8000.994.2142.0, is what AppxManifest.xml depends on; keep
         the versions in step (they match Microsoft.WindowsAppSDK 1.8.260921001). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="1.8.79" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="1.8.251216001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260921001" />
  </ItemGroup>
</Project>
